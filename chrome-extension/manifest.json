{
  "manifest_version": 3,
  "name": "Music Desktop 桌面歌词",
  "version": "1.0.0",
  "description": "把 Music Desktop 正在播放的歌词浮动显示在当前网页最上层，浏览器全屏时也可见。",
  "minimum_chrome_version": "102",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
